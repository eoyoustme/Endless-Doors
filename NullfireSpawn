-- Shadow Normal Script (Tự động xuất hiện nếu tìm thấy keyhitbox)
local NullFire = "https://github.com/eoyoustme/Endless-Doors/raw/main/Nullfire.rbxm"

function getgithubmodeL(url)
	if not (writefile and getcustomasset and request) then return nil end
	local fileName = string.match(url, "([^/]+)$") or "temp_model.rbxm"
	local response = request({Url = url, Method = "GET"})
	if response.StatusCode ~= 200 then return nil end
	writefile(fileName, response.Body)
	local assetId = getcustomasset(fileName)
	local success, result = pcall(function() return game:GetObjects(assetId)[1] end)
	return success and result or nil
end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

-- Load shadow asset
local success, shadowAsset = pcall(function()
	return getgithubmodeL(NullFire)
end)

if not success or not shadowAsset then
	warn("[Shadow] Không load được shadow asset")
	return
end

-- Tìm keyhitbox trong workspace
local function findKeyHitbox()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name:lower() == "keyhitbox" then
			return obj
		end
	end
	return nil
end

-- Spawn shadow
local function spawnShadow(keyhitbox)
	local shadow = shadowAsset:Clone()
	shadow.Parent = workspace

	local handle = shadow:FindFirstChild("Handle", true) 
		or shadow:FindFirstChildWhichIsA("BasePart", true) 
		or shadow.PrimaryPart

	if not handle then 
		shadow:Destroy()
		return 
	end

	if not shadow.PrimaryPart then
		shadow.PrimaryPart = handle
	end

	-- Đặt vị trí trên keyhitbox
	local spawnPos = keyhitbox.CFrame * CFrame.new(0, 2, 0)
	shadow:PivotTo(spawnPos)

	for _, p in ipairs(shadow:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = false
		end
	end

	local usedOnce = false
	local exploded = false

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Take"
	prompt.ObjectText = "???"
	prompt.MaxActivationDistance = 5
	prompt.HoldDuration = 0
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.RequiresLineOfSight = false
	prompt.Parent = handle

	prompt.Triggered:Connect(function(plr)
		if plr ~= player or exploded then return end

		-- Lần 1: Tải Crucifix
		if not usedOnce then
			usedOnce = true
			pcall(function()
				loadstring(game:HttpGet("https://raw.githubusercontent.com/eoyoustme/Endless-Doors/refs/heads/main/Nullfire"))()
			end)
			return
		end

		-- Lần 2: Nổ & Giết
		exploded = true

		for _, p in ipairs(shadow:GetDescendants()) do
			if p:IsA("BasePart") then
				TweenService:Create(p, TweenInfo.new(0.3), {
					Transparency = 1,
					Size = p.Size * 2
				}):Play()
			end
		end

		task.wait(0.15)
		local char = player.Character
		if char and char:FindFirstChild("Humanoid") then
			char.Humanoid.Health = 0
		end

		task.delay(1, function()
			if shadow then shadow:Destroy() end
		end)
	end)

	-- Thông báo caption
	pcall(function()
		require(player.PlayerGui.MainUI.Initiator.Main_Game).caption("Something has spawned", true)
	end)
end

-- Hàm kiểm tra và thực thi spawn
local function checkAndSpawn()
	local keyhitbox = findKeyHitbox()
	if keyhitbox then
		spawnShadow(keyhitbox)
	end
end

-- 1️⃣ Chạy ngay lập tức khi vừa Execute script (nếu có keyhitbox sẵn)
task.spawn(checkAndSpawn)

-- 2️⃣ Lắng nghe khi người chơi sang phòng mới
local gameData = ReplicatedStorage:WaitForChild("GameData", 5)
if gameData then
	local latestRoom = gameData:WaitForChild("LatestRoom", 5)
	if latestRoom then
		latestRoom.Changed:Connect(function()
			task.wait(0.3)
			checkAndSpawn()
		end)
	end
end

print("[Shadow] Loaded | Tự động xuất hiện ngay khi có keyhitbox")
