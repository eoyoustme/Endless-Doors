local NullFire = "https://github.com/eoyoustme/Endless-Doors/raw/main/Nullfire.rbxm"

function getgithubmodeL(url)
	if not (writefile and getcustomasset and request) then return nil end
	local fileName = string.match(url, "([^/]+)$") or "temp_model.rbxm"
	local response = request({Url = url, Method = "GET"})
	if response.StatusCode ~= 200 then return nil end
	writefile(fileName, response.Body)
	local assetId = getcustomasset(fileName)
	local success, result = pcall(function() return game:GetObjects(assetId)[1] end)
	return success and result or nil
end

local Candle = getgithubmodeL(NullFire)
if not Candle then 
	warn("Không thể tải model Candle!")
	return 
end
Candle.Name = "Nullifier"

local plr = game.Players.LocalPlayer
Candle.Parent = plr:WaitForChild("Backpack")

-- Chỉnh sửa thuộc tính của Candle an toàn
if Candle:FindFirstChild("Handle") then
	Candle.Handle.CanCollide = false
	Candle.Handle.Material = Enum.Material.Salt

	local flame = Candle.Handle:FindFirstChild("Top") and Candle.Handle.Top:FindFirstChild("Flame")
	if flame and flame:FindFirstChild("GuidingLighteffect") then
		local lightEffect = flame.GuidingLighteffect
		if lightEffect:FindFirstChild("PointLight") then
			lightEffect.PointLight.Brightness = 1
			lightEffect.PointLight.Range = 10
		end
		if lightEffect:FindFirstChild("EffectLight") then
			lightEffect.EffectLight.LockedToPart = true
		end
	end
end

for _, v in pairs(Candle:GetDescendants()) do
	if v:IsA("BasePart") then
		v.CanCollide = false
	end
end

-- KHỞI TẠO ANIMATION
local AnimIdle = Instance.new("Animation")
AnimIdle.AnimationId = "rbxassetid://9982615727"
AnimIdle.Name = "IDleloplolo"

local track = nil

-- Hàm tự động load Animation vào Nhân vật
local function loadAnimForCharacter(char)
	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then return end
	local animator = hum:WaitForChild("Animator", 5)
	if not animator then return end

	track = animator:LoadAnimation(AnimIdle)
	track.Priority = Enum.AnimationPriority.Action -- BẮT BUỘC: Đặt ưu tiên cao để đè lên dáng đứng mặc định
	track.Looped = true
end

-- Tải animation cho nhân vật hiện tại
if plr.Character then
	loadAnimForCharacter(plr.Character)
end

-- Tự động cập nhật lại Animation mỗi khi nhân vật hồi sinh (Respawn)
plr.CharacterAdded:Connect(function(newChar)
	loadAnimForCharacter(newChar)
end)

-- SỰ KIỆN EQUIPPED & UNEQUIPPED
Candle.Equipped:Connect(function()
	local char = plr.Character
	if not char then return end

	local hum = char:FindFirstChild("Humanoid")
	local animator = hum and hum:FindFirstChild("Animator")

	-- Nếu track bị mất hoặc chưa kịp load thì load lại ngay lúc Equip
	if not track and animator then
		track = animator:LoadAnimation(AnimIdle)
		track.Priority = Enum.AnimationPriority.Action
		track.Looped = true
	end

	if track then
		track:Play()
	end
end)

Candle.Unequipped:Connect(function()
	if track then
		track:Stop()
	end
end)
