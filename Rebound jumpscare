local function playSoundSafe(soundObj, timePos, speed, volume)
	if not soundObj or not soundObj.Parent then
		return
	end

	soundObj:Stop()
	soundObj.TimePosition = timePos or 0
	soundObj.PlaybackSpeed = speed or 1
	soundObj.Volume = volume or 1
	soundObj:Play()
end

function GitPNG(GithubImg, ImageName)
	local url = GithubImg
	if not isfile(ImageName .. ".png") then
		local success, response = pcall(function()
			return game:HttpGet(url)
		end)
		if success then
			writefile(ImageName .. ".png", response)
		else
			error(": " .. response)
		end
	end
	return (getcustomasset or getsynasset)(ImageName .. ".png")
end

